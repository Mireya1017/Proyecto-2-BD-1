# ==============================================================================
# Configuración de Conexión a PostgreSQL - Sistema Restaurante
# Copie este archivo como .env y complete con las credenciales locales o remotas
# ==============================================================================

# Servidor de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurante_prueba
DB_USER=postgres
DB_PASSWORD=su_contraseña_aqui

# Configuración del Pool de Conexiones
DB_MIN_CONN=1
DB_MAX_CONN=10

# Modo de operación (produccion / prueba)
APP_ENV=desarrollo
